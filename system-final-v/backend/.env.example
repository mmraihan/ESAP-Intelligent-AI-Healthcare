# ESAP backend — copy to .env and adjust. No secrets belong in git.

# stub  = deterministic, contract-correct predictions; runs anywhere (default)
# real  = load the DUA-restricted artifact bundles from ESAP_EXPORTS_DIR
MODEL_MODE=stub

# Read-only mount of the model_exports/ handoff. Only read in MODEL_MODE=real.
# ESAP_EXPORTS_DIR=../../../ml-pipeline/model_exports

# SQLite file. Deleted + reseeded by `python -m app.seed --reset`.
ESAP_DB_PATH=esap.db

# Seed dataset, generated by the frontend (npm run seed:dump). Single source.
ESAP_SEED_PATH=seed/seed.json

# Browser origins allowed to call the API (the Vite dev server).
ESAP_CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# Plus any origin matching this pattern. Default: any port on localhost, since
# Vite moves to 5176, 5177… when 5175 is busy. Empty turns the pattern off.
# ESAP_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# Reverse proxies / load balancers in front of the API, comma-separated IPs.
# Only requests from these may name the real visitor in X-Forwarded-For, which
# the public waitlist's per-visitor rate limit keys on. Unset = no proxy; behind
# one, leaving it unset gives every visitor one shared quota.
# ESAP_TRUSTED_PROXIES=10.0.0.5

# Secret used to sign session tokens. Generated per-process if unset.
# ESAP_SECRET=change-me

# The sign-in page's "sign in as any role" picker. Turn off for a real deployment.
# ESAP_DEMO_PICKER=true

# Polar payments. sandbox (default) uses sandbox-api.polar.sh and the sandbox
# product ids; production uses api.polar.sh. Token: Polar → Settings → Access
# Tokens. Secret: Settings → Webhooks → (the ESAP Clinical AI endpoint).
# Server environment only — never in git, never in the frontend.
# POLAR_ENV=sandbox
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_WEBHOOK_SECRET=whsec_...
# Local testing: point checkout back at the Vite dev server instead of care.esap.ai.
# BILLING_SUCCESS_URL=http://localhost:5175/billing/success?checkout_id={CHECKOUT_ID}
# BILLING_RETURN_URL=http://localhost:5175/pricing

# Non-production entitlement gating GET /api/v1/cases/{hadm_id}/prefill (§8).
ESAP_ALLOW_PREFILL=false

# --- Accounts and sessions (QA issues 8, 13, 17) ------------------------------
# Signed out after this many minutes with no request. 0 turns it off.
# ESAP_IDLE_TIMEOUT_MINUTES=30
# Wrong passwords or MFA codes within the window before an address is locked.
# ESAP_LOCKOUT_THRESHOLD=5
# ESAP_LOCKOUT_MINUTES=15
# Admin and platform roles must enrol two-factor sign-in before using the
# console. On by default. Shared demo accounts are exempt while ESAP_DEMO_PICKER is on.
# ESAP_REQUIRE_ADMIN_MFA=true
# Where links in emails (password reset, invites) point. Production: the website.
# ESAP_PUBLIC_URL=https://care.esap.ai
# HttpOnly session cookie. Secure is automatic over HTTPS when the proxy sends
# X-Forwarded-Proto; set it explicitly if unsure. SameSite defaults to None over
# HTTPS. The cookie only survives a reload in Safari/Firefox when the API is on
# the same site as the website (e.g. api.care.esap.ai), not on another domain.
# ESAP_COOKIE_SECURE=true
# ESAP_COOKIE_SAMESITE=none
# ESAP_COOKIE_DOMAIN=

# --- Outgoing mail -------------------------------------------------------------
# Unset host = mail is only written to the mail_outbox table (and the log).
# ESAP_SMTP_HOST=smtp.example.com
# ESAP_SMTP_PORT=587
# ESAP_SMTP_USER=
# ESAP_SMTP_PASSWORD=
# ESAP_MAIL_FROM=ESAP Clinical AI <no-reply@esap.ai>

# --- Retention (QA issue 9) ------------------------------------------------------
# Hours between scheduled purges; first run 5 minutes after start. 0 turns it off.
# ESAP_RETENTION_INTERVAL_HOURS=24
